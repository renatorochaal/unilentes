# Banco de dados PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/unilentes?schema=public"

# JWT
JWT_SECRET="troque-em-producao-minimo-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-em-producao-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Servidor
PORT=3030
NODE_ENV=development

# CORS - origin do frontend
CORS_ORIGIN="http://localhost:5173"

# Diretório onde os arquivos de exportação são salvos
EXPORTS_DIR="./exports"
